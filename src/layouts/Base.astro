---
import { languages, isRtl } from '../i18n/config';
import { getFontProfile } from '../lib/fonts';
import fontTokens from '../styles/fonts.css?url';
import fontLatin from '../styles/fonts-latin.css?url';
import fontArabic from '../styles/fonts-arabic.css?url';
import fontHebrew from '../styles/fonts-hebrew.css?url';
import fontCjk from '../styles/fonts-cjk.css?url';
import fontIndic from '../styles/fonts-indic.css?url';

interface Props {
  title: string;
  lang: string;
  description: string;
}

const {
  title,
  lang,
  description,
} = Astro.props;

const dir = isRtl(lang) ? "rtl" : "ltr";
const fontProfile = getFontProfile(lang);
const fontBundles: Record<string, string> = {
  latin: fontLatin,
  arabic: fontArabic,
  hebrew: fontHebrew,
  cjk: fontCjk,
  indic: fontIndic,
};
---
<!DOCTYPE html>
<html lang={lang} dir={dir}>
<head>
  <title>{title}</title>
  <meta charset="UTF-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="light dark">
  <meta name="description" content={description}>
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:type" content="website">
  <link rel="me" href="https://techhub.social/@keepandroidopen">
  <link rel="stylesheet" href="/css/pico.min.css">
  <link rel="stylesheet" href={fontTokens} />
  <link rel="stylesheet" href={fontBundles[fontProfile]} />

  <!-- <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@picocss/pico@2/css/pico.colors.min.css"> -->
  <style is:global>
  /*!
   * @license magnet:?xt=urn:btih:8e4f440f4c65981c5bf93c76d35135ba5064d8b7&dn=apache-2.0.txt Apache-2.0
   * Keep Android Open – Base Styles
   * Copyright 2025-2026 Keep Android Open Contributors
   * SPDX-License-Identifier: Apache-2.0
   */

    main {
      max-width: min(72rem, 100%);
      margin-inline: auto;
      padding: 2rem 1.5rem;
    }

    main.landing-main {
      max-width: min(var(--kao-shell-width, 54rem), 100%);
      padding-block: 1.5rem 3rem;
    }

    .skip-link {
      position: fixed;
      z-index: 10000;
      inset-block-start: 0.75rem;
      inset-inline-start: 0.75rem;
      padding: 0.65rem 0.9rem;
      border-radius: 0.45rem;
      background: var(--kao-surface, #fff);
      color: var(--pico-color);
      border: 2px solid var(--kao-focus, currentColor);
      transform: translateY(-200%);
      transition: transform 0.15s ease;
    }

    .skip-link:focus-visible {
      transform: translateY(0);
    }

    .skip-link:focus:not(:focus-visible) {
      transform: translateY(-200%);
    }
    
    h1 {
      text-align: start;
    }

    .outerlync {
      /* cursor: not-allowed; */
      display: inline-block;
      background: transparent;
    }

    .innerlync {
      transform-style: preserve-3d;
      transition: ease-out 0.6s;
    }

    .outerlync:hover .innerlync {
      transition: ease-in-out 2.5s;
      transform: rotate(1800deg) rotateX(0deg) rotateY(0deg) rotateZ(0deg);
    }

    .lang-menu {
      text-align: center;
      font-size: smaller;
      padding-bottom: 0.5em;
      margin-left: 20px;
      margin-right: 20px;
      margin-bottom: 0.5em;
      border-bottom: 1px solid lightgray;
    }

    .lang-menu a {
      white-space: nowrap;
    }

    .open-letter-cta {
      text-align: center;
      padding: 0.75rem 1rem;
      background: linear-gradient(135deg, #1a1a2e, #16213e);
      border-bottom: 3px solid #3498db;
    }

    .open-letter-cta a {
      color: #fff;
      font-weight: 800;
      font-size: 1.1rem;
      text-decoration: none;
      letter-spacing: 0.02em;
    }

    .open-letter-cta a:hover {
      text-decoration: underline;
    }

    footer {
      /* padding: 0px; */
      /* margin: 0px; */
      font-size: 14px;
      line-height: 1.6;
      width: 100%;
      border-top: 1px solid #dee2e6;
    }

    .li-list {
      list-style: none;
      align-items: center;
      vertical-align: middle;
      background-repeat: no-repeat;
      padding-inline-start: 2em;
      line-height: 1.5;
      content: "➤ ";
    }

    .li-list::before {
      margin-inline-end: 0.5em;
    }

    .li-money::before {
      mask: url('/img/money_bag.svg') no-repeat center / contain;
      -webkit-mask: url('/img/money_bag.svg') no-repeat center / contain;
      background-color: var(--pico-color);
      width: 1em;
      height: 1em;
      content: "";
      display: inline-block;
      margin-inline-start: -1.5em;
      margin-inline-end: 0.5em;
    }

    .li-terms::before {
      mask: url('/img/contract_edit.svg') no-repeat center / contain;
      -webkit-mask: url('/img/contract_edit.svg') no-repeat center / contain;
      background-color: var(--pico-color);
      width: 1em;
      height: 1em;
      content: "";
      display: inline-block;
      margin-inline-start: -1.5em;
      margin-inline-end: 0.5em;
    }

    .li-id::before {
      mask: url('/img/id_card.svg') no-repeat center / contain;
      -webkit-mask: url('/img/id_card.svg') no-repeat center / contain;
      background-color: var(--pico-color);
      width: 1em;
      height: 1em;
      content: "";
      display: inline-block;
      margin-inline-start: -1.5em;
      margin-inline-end: 0.5em;
    }

    .li-signing::before {
      mask: url('/img/fingerprint.svg') no-repeat center / contain;
      -webkit-mask: url('/img/fingerprint.svg') no-repeat center / contain;
      background-color: var(--pico-color);
      width: 1em;
      height: 1em;
      content: "";
      display: inline-block;
      margin-inline-start: -1.5em;
      margin-inline-end: 0.5em;
    }

    .li-appids::before {
      mask: url('/img/receipt.svg') no-repeat center / contain;
      -webkit-mask: url('/img/receipt.svg') no-repeat center / contain;
      background-color: var(--pico-color);
      width: 1em;
      height: 1em;
      content: "";
      display: inline-block;
      margin-inline-start: -1.5em;
      margin-inline-end: 0.5em;
    }

    .header-icons {
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 0.25rem;
    }

    .header-icon-link {
      padding: 0.5rem;
      transition: all 0.3s ease;
      display: inline-flex;
      align-items: center;
    }

    .header-icon-link:hover {
      opacity: 0.8;
    }

    /* Social media icons – CSS mask with brand colors */
    .social-icon {
      display: inline-block;
      -webkit-mask-size: contain;
      mask-size: contain;
      -webkit-mask-repeat: no-repeat;
      mask-repeat: no-repeat;
      -webkit-mask-position: center;
      mask-position: center;
    }

    .icon-mastodon {
      -webkit-mask-image: url('/img/mastodon.svg');
      mask-image: url('/img/mastodon.svg');
      background-color: #6364FF;
    }

    .icon-bluesky {
      -webkit-mask-image: url('/img/bluesky.svg');
      mask-image: url('/img/bluesky.svg');
      background-color: #1185FE;
    }

    .icon-x {
      -webkit-mask-image: url('/img/x-twitter.svg');
      mask-image: url('/img/x-twitter.svg');
      background-color: #14171A;
    }

    [data-theme="dark"] .icon-mastodon {
      background-color: #858AFA;
    }

    [data-theme="dark"] .icon-bluesky {
      background-color: #409CFF;
    }

    [data-theme="dark"] .icon-x {
      background-color: #E7E9EA;
    }

    .icon-linkedin {
      -webkit-mask-image: url('/img/linkedin.svg');
      mask-image: url('/img/linkedin.svg');
      background-color: #0A66C2;
    }

    [data-theme="dark"] .icon-linkedin {
      background-color: #5BA4E5;
    }

    .icon-facebook {
      -webkit-mask-image: url('/img/facebook.svg');
      mask-image: url('/img/facebook.svg');
      background-color: #1877F2;
    }

    [data-theme="dark"] .icon-facebook {
      background-color: #4A9AF5;
    }

    .callout-warning {
      border-inline-start: 4px solid #d32f2f;
      background: rgba(211, 47, 47, 0.08);
      padding: 1rem 1.5rem;
      margin: 1.5rem 0;
      border-start-end-radius: 0.5rem;
      border-end-end-radius: 0.5rem;
    }

    .callout-warning h3 {
      margin-top: 0;
      color: #d32f2f;
    }

    .callout-warning blockquote {
      border-inline-start: none;
      background: rgba(211, 47, 47, 0.08);
      border-radius: 0.5rem;
      padding: 1rem 1.5rem;
      margin: 1rem 0;
      font-style: italic;
      font-size: 1.05em;
      color: var(--pico-color);
      quotes: "\201C" "\201D";
    }

    .callout-warning blockquote p::before {
      content: open-quote;
      font-size: 1.5em;
      font-weight: bold;
      color: #d32f2f;
      margin-inline-end: 0.15em;
      vertical-align: -0.15em;
      line-height: 0;
    }

    .callout-warning blockquote p::after {
      content: close-quote;
      font-size: 1.5em;
      font-weight: bold;
      color: #d32f2f;
      margin-inline-start: 0.1em;
      vertical-align: -0.15em;
      line-height: 0;
    }

    [data-theme="dark"] .callout-warning {
      background: rgba(211, 47, 47, 0.15);
    }

    [data-theme="dark"] .callout-warning h3 {
      color: #ef5350;
    }

    [data-theme="dark"] .callout-warning blockquote {
      background: rgba(211, 47, 47, 0.12);
    }

    [data-theme="dark"] .callout-warning blockquote p::before,
    [data-theme="dark"] .callout-warning blockquote p::after {
      color: #ef5350;
    }

    details > summary {
      list-style: none;
      cursor: pointer;
    }

    details > summary::-webkit-details-marker {
      display: none;
    }

    details > summary::after {
      content: none !important;
      background: none !important;
    }

    details > summary > h4 {
      display: inline;
    }

    details > summary::before {
      content: '▸';
      font-size: 1.25em;
      display: inline-block;
      margin-inline-end: 0.4em;
      transition: transform 0.2s ease;
      vertical-align: middle;
    }

    details[open] > summary::before {
      transform: rotate(90deg);
    }

    [dir="rtl"] details > summary::before {
      transform: scaleX(-1);
    }

    [dir="rtl"] details[open] > summary::before {
      transform: scaleX(-1) rotate(-90deg);
    }

  </style>
</head>
<body>
  <a class="skip-link" href="#main-content">Skip to content</a>
  <slot />
  <script is:inline>
    /**
     * @license magnet:?xt=urn:btih:8e4f440f4c65981c5bf93c76d35135ba5064d8b7&dn=apache-2.0.txt Apache-2.0
     * Keep Android Open – Hash-based Details Opener
     * Copyright 2025–2026 Keep Android Open Contributors
     * SPDX-License-Identifier: Apache-2.0
     */
    function openDetailsForHash() {
      var hash = location.hash;
      if (!hash) return;
      var target = document.querySelector(hash);
      if (!target) return;
      var el = target;
      while (el) {
        if (el.tagName === 'DETAILS') el.open = true;
        el = el.parentElement;
      }
      target.scrollIntoView();
    }
    openDetailsForHash();
    window.addEventListener('hashchange', openDetailsForHash);
    // @license-end
  </script>
</body>
</html>
