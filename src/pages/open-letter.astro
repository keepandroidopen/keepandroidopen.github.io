---
import Letter from "../layouts/Letter.astro";
import { getEntry, render } from 'astro:content';
import Signatories from '../components/Signatories.astro';

const entry = await getEntry('pages', 'letter');
if (!entry) throw new Error('Letter content not found');
const { Content } = await render(entry);
const { data } = entry;
---
<Letter {...data}>
  <article class="letter-article">
    <h1 class="letter-title">{data.title}</h1>
    <Content />
    <Signatories mode="full" />
  </article>
</Letter>
